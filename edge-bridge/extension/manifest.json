{
  "manifest_version": 3,
  "name": "Raw Edge Bridge",
  "version": "0.4.0",
  "description": "Lets the local Raw browser tool drive tabs in this Edge profile.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "browsingData",
    "cookies",
    "debugger",
    "downloads",
    "history",
    "management",
    "nativeMessaging",
    "notifications",
    "proxy",
    "scripting",
    "sessions",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Raw Edge Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
