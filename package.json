{
  "name": "raw-agent",
  "version": "0.4.0",
  "description": "A bare model + tools loop in your terminal. No system prompt, no runtime dependencies, no scaffolding.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "openai",
    "anthropic",
    "browser-automation",
    "cdp"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "raw": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "node --no-warnings scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && node scripts/smoke-cli.mjs && node scripts/smoke-providers.mjs && node scripts/smoke-permissions.mjs && node scripts/smoke-setup.mjs",
    "prepublishOnly": "npm run check",
    "prepack": "node --no-warnings scripts/build.mjs",
    "start": "node src/cli.ts",
    "dev": "node src/cli.ts",
    "test": "node --no-warnings --test",
    "smoke:cli": "npm run build && node scripts/smoke-cli.mjs",
    "smoke:providers": "npm run build && node scripts/smoke-providers.mjs",
    "smoke:permissions": "npm run build && node scripts/smoke-permissions.mjs",
    "smoke:setup": "npm run build && node scripts/smoke-setup.mjs",
    "smoke:browser": "npm run build && node scripts/smoke-browser.mjs",
    "setup": "node src/cli.ts setup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liutingqiu/raw-agent.git"
  },
  "bugs": {
    "url": "https://github.com/liutingqiu/raw-agent/issues"
  },
  "homepage": "https://github.com/liutingqiu/raw-agent#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
